# ==============================================================
# Aaum Creations AI Chatbot — Environment Configuration
# ==============================================================
# NOTE: Never commit your actual '.env' or '.env.local' file to git!
# Copy this file to '.env.local' and provide your real Google Gemini API Key.

# --------------------------------------------------------------
# Backend (Server-Side Only - NEVER exposed to client)
# --------------------------------------------------------------
# Your official Google Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model to use (e.g. gemini-3-flash-preview or gemini-3.1-flash-lite-preview)
GEMINI_MODEL=gemini-3-flash-preview

# --------------------------------------------------------------
# Frontend / Client Configuration (Safe to expose)
# --------------------------------------------------------------
# Business WhatsApp phone number with country code (e.g. 91 for India)
# Example: 917094556516 (digits only for WhatsApp URL)
VITE_WHATSAPP_PHONE_NUMBER=917094556516

# Optional custom pre-filled WhatsApp greeting
VITE_WHATSAPP_MESSAGE="Hello Aaum Creations, I would like to inquire about your Soursop Leaves."
